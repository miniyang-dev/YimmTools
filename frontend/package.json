{
  "name": "yimmtool-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "npm run build && playwright test",
    "e2e:ui": "npm run build && playwright test --ui",
    "check": "tsc --noEmit && eslint . && prettier --check . && vitest run",
    "i18n:cn": "node scripts/gen-zh-cn.mjs"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource-variable/noto-serif-jp": "^5.2.5",
    "@fontsource-variable/noto-serif-sc": "^5.2.5",
    "@fontsource-variable/noto-serif-tc": "^5.2.5",
    "@fontsource-variable/source-serif-4": "^5.2.5",
    "cron-parser": "4.9.0",
    "cronstrue": "^2.50.0",
    "diff": "^5.2.0",
    "dompurify": "^3.2.4",
    "js-md5": "^0.8.3",
    "jsqr": "^1.4.0",
    "marked": "^15.0.7",
    "papaparse": "^5.5.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "ua-parser-js": "1.0.40",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/diff": "^5.2.3",
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.3.15",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ua-parser-js": "^0.7.39",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "opencc-js": "^1.0.5",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
