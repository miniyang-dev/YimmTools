  "narrative": {
    "northStar": "The Daily Edition",
    "overview": "YimmTool 是一份每天都會翻開的技術日報。淺色是日報（暖紙、墨黑），深色是夜報（同一版面，換成夜間印刷）。版面靠規線、字級與留白建立秩序，而不是靠卡片、陰影或漸層；一頁只有一個重點色，用在「現在正在發生的事」。",
    "keyCharacteristics": [
      "規線取代容器：雙線頁眉、細線分隔、方正輸入框，沒有圓角卡片。",
      "單一朱紅強調色，面積永遠很小。",
      "襯線為聲音、無襯線為操作、等寬為資料。",
      "扁平：深度只靠規線與底色階，沒有陰影。"
    ],
    "rules": [
      {
        "name": "The One Vermilion Rule",
        "body": "朱紅只標記「現在」。裝飾、分類、標題都不准用它。",
        "section": "colors"
      },
      {
        "name": "The Two Editions Rule",
        "body": "日報與夜報是同一版面的兩個印次：每個顏色角色都有對應，任何新元件兩種都要驗。",
        "section": "colors"
      },
      {
        "name": "The Three Voices Rule",
        "body": "襯線說話、無襯線操作、等寬記數據；不混用，也不再加第四種字體。",
        "section": "typography"
      },
      {
        "name": "The Flat-As-Print Rule",
        "body": "像印刷品：想強調就加規線或反白，不要加陰影。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 用規線與底色階建立層次；重點用反白。",
      "Do 讓朱紅只出現在「當下」的訊號上，且面積很小。",
      "Do 每個新元件在日報、夜報、五種語系下各看一次。",
      "Do 所有資料欄位用等寬字並開啟 tabular-nums。",
      "Do 在會讓資料離開瀏覽器的工具頁標示「需連線伺服器」。"
    ],
    "donts": [
      "Don't 使用卡片、圓角、陰影、玻璃或漸層。",
      "Don't 在標題上方加小標籤（kicker），或用編號裝飾區段；編號只作目錄頁碼。",
      "Don't 把朱紅用在裝飾、分類或大面積背景。",
      "Don't 加入彈窗、橫幅、行銷文案或未經證實的用量、評價。",
      "Don't 用 border-left 粗色條標示訊息。"
    ]
  }
